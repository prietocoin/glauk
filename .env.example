# ============================================================
# Glauk — configuración única
# Copiar a .env solo en desarrollo. En producción usar secrets.
# ============================================================

# --- Entorno ---
APP_ENV=development
PORT=3000
TZ=UTC
LOG_LEVEL=info
LOG_FORMAT=auto
SHUTDOWN_TIMEOUT=15s

# --- Base de datos ---
# DATABASE_URL tiene prioridad sobre DB_*.
DATABASE_URL=postgres://glauk:glauk@localhost:5432/glauk?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=glauk
DB_PASSWORD=glauk
DB_NAME=glauk
DB_SSLMODE=disable
DB_ALLOW_INSECURE=false
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s
DB_STATEMENT_TIMEOUT=10s

# --- Evolution API ---
# Vacío = simulación. En producción es obligatorio.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# AUTHENTICATION_API_KEY=   # alias legado; no definir junto con la anterior
EVOLUTION_INSTANCE=Glauk
EVOLUTION_TIMEOUT=25s
EVOLUTION_MAX_RETRIES=2
EVOLUTION_RETRY_BASE=300ms

# --- HTTP ---
CORS_ALLOWED_ORIGINS=https://glauk.jairokov.com,https://automat-glauk-ui.fyi6ur.easypanel.host,http://localhost:3000,http://localhost:5173
BODY_LIMIT_BYTES=20971520
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=90s
HTTP_IDLE_TIMEOUT=60s

# --- Seguridad ---
# Vacío = admin deshabilitado (503). No hay clave por defecto.
ADMIN_API_KEY=
# Vacío = mutaciones abiertas por compatibilidad (WARN en producción).
SECURITY_API_KEY=

# --- Reportes ---
REPORT_IMAGE_MAX_BYTES=10485760
REPORT_IMAGE_MIN_DIMENSION=200
REPORT_IMAGE_MAX_DIMENSION=4096
REPORT_IMAGE_MAX_PIXELS=16000000
REPORT_IDEMPOTENCY_TTL=10m
REPORT_RATE_LIMIT_PER_MINUTE=60

# --- Tasas ---
JID_GRUPO_PRUEBA=
HOO_GLOBAL_RATES_URL=https://hoo.jairokov.com/global-rates
HOO_TIMEOUT=10s

# --- Ingesta nativa (remitHub + glaukapi) ---
# false = la ruta del webhook responde 503 y no arranca workers.
INGESTA_ENABLED=false
INGESTA_QUEUE_SIZE=100
INGESTA_WORKERS=5
INGESTA_MAX_RETRIES=3
INGESTA_RETRY_BASE=500ms
INGESTA_JOB_TIMEOUT=2m
INGESTA_MAX_IMAGE_BYTES=20971520
# Escribe también la tabla legacy comprobantes_final si existe.
INGESTA_ESCRIBIR_FINAL=false

# --- Cloudflare R2 (S3 compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=remesas-img
R2_PUBLIC_DOMAIN=
# Vacío = se deriva de R2_ACCOUNT_ID.
R2_ENDPOINT=

# --- Google Gemini ---
# GEMINI_KEYS admite varias claves separadas por coma y tiene prioridad.
GEMINI_API_KEY=
GEMINI_KEYS=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=45s

# --- Diagnóstico ---
ENABLE_PPROF=false
